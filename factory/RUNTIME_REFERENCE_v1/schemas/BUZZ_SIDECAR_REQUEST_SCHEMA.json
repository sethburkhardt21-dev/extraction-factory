{
  "schema_version": "1.0",
  "required": [
    "request_id",
    "action"
  ],
  "actions": {
    "status": {
      "optional": [
        "estate_id",
        "capsule_id"
      ]
    },
    "launch": {
      "required": [
        "capsule_id",
        "role"
      ],
      "optional": [
        "preferred_capability",
        "preferred_model"
      ]
    },
    "pause": {
      "required": [
        "scope_type",
        "scope_id"
      ]
    },
    "resume": {
      "required": [
        "scope_type",
        "scope_id"
      ]
    },
    "incident": {
      "required": [
        "incident_id"
      ]
    }
  },
  "authority_rule": "Buzz requests actions; sidecar scheduler/ledger determines legal transitions."
}